[Unit]
Description=ENSM - Enterprise Network System Management (All Services)
Documentation=https://github.com/ensm/ensm
After=network.target
Wants=ensm-auth.service ensm-main.service prometheus.service node_exporter.service loki.service promtail.service caddy.service grafana-server.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/true

[Install]
WantedBy=multi-user.target

